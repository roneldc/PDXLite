{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PDXLite": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
    },
    "File": {
      "Path": "Logs/pdxlite-.log",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 30,
      "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
    }
  },

  "AllowedHosts": "*",

  "AppSettings": {
    "AppName": "PDXLite"
  },

  "Gemini": {
    "Model": "gemini-2.5-flash",
    "TimeoutSeconds": 30,
    "MaxRetries": 3
  },

  "Jwt": {
    "ExpiryInDays": 30
  },

  "RateLimiting": {
    "Anonymous": {
      "PermitLimit": 5,
      "WindowMinutes": 60
    },
    "Authenticated": {
      "PermitLimit": 100,
      "WindowMinutes": 60
    },
    "ApiKey": {
      "PermitLimit": 1000,
      "WindowHours": 24
    }
  },

  "FileUpload": {
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".pdf" ]
  }
}
